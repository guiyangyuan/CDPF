+def build_view_aggregator(cfg, dim):
+    tc = cfg.TRAINER.TEXTCONSISTENCY
+    return ViewAggregator(dim, tc.N_VIEWS, tc.AGGREGATION, tc.N_GROUPS, tc.USE_FEATURE_ADAPTER)
