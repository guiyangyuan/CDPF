+"""Exercise the export CLI's real no-CUDA refusal; never start CPU inference."""
+from pathlib import Path
+import argparse,os,subprocess,json,hashlib,time
+p=argparse.ArgumentParser();p.add_argument('--prepared-root',type=Path,required=True);a=p.parse_args()
+root=Path(__file__).resolve().parents[2];repo=root/'work/github-publish/textconsistency-validation';parent=a.prepared_root.resolve()
+out=parent/'cuda-unavailable-rejection'
+if out.exists():raise FileExistsError(out)
+command=[str(root/'work/tc-venv/bin/python'),'-B',str(repo/'scripts/repro/validation_probe.py'),'export','--prepared',str(parent/'ucf101-seed1/prepared.json'),'--output-dir',str(out)]
+env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1','PYTHONPATH':f'{repo}:{repo}/Dassl.pytorch','OMP_NUM_THREADS':'1','OPENBLAS_NUM_THREADS':'1','MKL_NUM_THREADS':'1'}
+start=time.monotonic();log=parent/'cuda-unavailable-rejection.log'
+with log.open('w') as stream:r=subprocess.run(command,cwd=repo,env=env,stdout=stream,stderr=subprocess.STDOUT)
+failure=json.loads((out/'failure.json').read_text())
+assert r.returncode!=0 and 'CUDA' in failure['error']
+assert not (out/'export.json').exists() and not (out/'logits.npz').exists()
+receipt={'passed':True,'check':'CUDA unavailable refuses real model export','returncode':r.returncode,'seconds':time.monotonic()-start,'command':command,'failure':failure,'no_logits_or_success_export':True,'log_sha256':hashlib.sha256(log.read_bytes()).hexdigest()}
+(parent/'cuda-unavailable-check.json').write_text(json.dumps(receipt,indent=2)+'\n');print(json.dumps(receipt,indent=2))
diff --git a/reports/preparation/validation-probe-20260911/execution/run_local_preparation.py b/reports/preparation/validation-probe-20260911/execution/run_local_preparation.py
new file mode 100644
index 0000000..c07f517
--- /dev/null
+++ b/reports/preparation/validation-probe-20260911/execution/run_local_preparation.py
@@ -0,0 +1,40 @@
+"""Run nine independent CPU prepare processes with retained logs and fixed inputs."""
+import argparse,hashlib,json,os,subprocess,time
+from pathlib import Path
+
+def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+
+def main():
+ parser=argparse.ArgumentParser();parser.add_argument('--label',required=True);args=parser.parse_args()
+ if not args.label or any(c not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_' for c in args.label):raise ValueError('Invalid label')
+ root=Path(__file__).resolve().parents[2]; work=root/'work/validation-probe-20260911'; repo=root/'work/github-publish/textconsistency-validation'
+ destination=work/f'prepared-{args.label}'
+ if destination.exists():raise FileExistsError(destination)
+ loc=json.loads((work/'local-input-locations.json').read_text())
+ inventory=repo/'reports/diagnostics/error-analysis-20260911/evidence/proposed-probe-inputs.json'
+ py=root/'work/tc-venv/bin/python'
+ revision=subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()
+ tools={str(p.relative_to(repo)):sha(p) for p in sorted((repo/'scripts/repro').glob('validation_*.py'))}
+ cases=[]
+ for dataset in ('ucf101','dtd','fgvc_aircraft'):
+  for seed in (1,2,3):
+   out=destination/f'{dataset}-seed{seed}'
+   command=[str(py),'-B',str(repo/'scripts/repro/validation_probe.py'),'prepare','--inventory',str(inventory),'--workspace-root',str(root),'--source-root',loc['source_roots'][dataset],'--data-root',loc['data_roots'][dataset],'--dataset',dataset,'--seed',str(seed),'--output-dir',str(out)]
+   cases.append({'dataset':dataset,'seed':seed,'output_dir':str(out),'command':command})
+ payload={'state':'running','revision':revision,'inventory_sha256':sha(inventory),'tools_sha256':tools,'cases':cases,'records':[],'new_training_runs':0,'gpu_export_run':False}
+ destination.mkdir(parents=True)
+ state=destination/'execution.json'
+ def save():state.write_text(json.dumps(payload,indent=2)+'\n')
