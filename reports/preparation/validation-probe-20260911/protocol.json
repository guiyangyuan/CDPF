{
  "version": 1,
  "purpose": "validation_only_crossed_inference_screening",
  "datasets": ["ucf101", "dtd", "fgvc_aircraft"],
  "seeds": [1, 2, 3],
  "split": "val",
  "subsample_classes": "base",
  "checkpoint_epoch": 20,
  "training_shots_per_class": 16,
  "validation_shots_per_class": 4,
  "new_training_runs": 0,
  "raw_branches": ["C", "S0", "S1", "M", "T0", "T1"],
  "students": ["C", "S0", "S1"],
  "teachers": ["M", "T0", "T1"],
  "fusion_rules": ["equal_logits", "equal_probabilities"],
  "alpha": 0.5,
  "softmax_temperature": 1.0,
  "primary_candidate": "equal_logits(S1,M)",
  "budget_screening": {
    "strong_controls": ["equal_logits(C,M)", "equal_probabilities(C,M)"],
    "candidate_minus_each_strong_control_macro_accuracy_pp_minimum": 0.0,
    "candidate_minus_each_strong_control_per_dataset_seed_mean_accuracy_pp_minimum": -1.0,
    "candidate_minus_equal_logits_S0_M_macro_accuracy_pp_strictly_greater_than": 0.0,
    "dataset_averaging": "equal_weight_after_three_seed_mean",
    "seed_dispersion": "sample_standard_deviation",
    "not_statistical_significance": true,
    "passing_does_not_establish_novel_accuracy_or_novelty": true,
    "no_automatic_training": true
  },
  "constraints": [
    "No validation fallback to test",
    "No per-dataset or per-seed model selection",
    "No weight, temperature, confidence threshold or prompt search",
    "Keep both teacher branches and record exact tensor equality",
    "Full raw logits and all fixed branch comparisons retained",
    "Nine unique dataset/seed cases required for aggregate screening",
    "Fresh independent confirmation still required before final scientific claim"
  ]
}
