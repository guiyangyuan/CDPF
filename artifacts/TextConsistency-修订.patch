+    details = {'trainer': 'CoOp', 'vision_depth': 0, 'language_depth': 0, 'vision_ctx': 0, 'language_ctx': 0}
+    model = clip.build_model(jit_model.state_dict(), details).float().eval()
+    model._repro_sha256 = digest
+    return model
